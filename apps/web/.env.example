# URL de la API que consumirá el navegador.
# En local: http://localhost:3001/api
# En producción: https://tu-api.onrender.com/api (o el dominio de Railway)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Alternativa recomendada en producción: se lee en tiempo de ejecución
# desde /config.js y permite cambiar la URL sin recompilar la imagen.
# NEXO_API_URL=https://tu-api.onrender.com/api
