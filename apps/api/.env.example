PORT=3001
NODE_ENV=development

# PostgreSQL local (desarrollo)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nexo
DB_PASSWORD=nexo
DB_NAME=nexo

# PostgreSQL en la nube (producción). Si existe, tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://usuario:password@host:5432/base?sslmode=require
# DB_SSL=true
DB_POOL_MAX=10

# MySQL (solo para migrar los datos de la app original)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mesa_ayuda_ciberseguridad

# Seguridad: en producción debe tener 32+ caracteres y no ser un valor de ejemplo.
JWT_SECRET=cambia-este-secreto
JWT_EXPIRA=8h

# Dominio(s) del frontend autorizados por CORS, separados por comas.
WEB_ORIGIN=http://localhost:3002

UPLOADS_DIR=uploads/evidencias
LEGACY_UPLOADS_DIR=
